{
  "name": "dsh-judge-loop",
  "version": "2.0.0",
  "description": "为真实项目产出可交付成品的双团队流程：教授只读题目与素材、定评分标准（不看稿，决定上限），导师按标准做到 95 分以上，成品直接交付。合格线 95 而非 100——95 是「发出去不会被问倒」。A two-team delivery loop for DeepSeek Harness: a professor writes the rubric blind, a tutor meets it, 95 is the bar.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./skills/*": "./skills/*",
    "./scripts/*": "./scripts/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "skills",
    "scripts",
    "agents",
    "test",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "demo": "node test/e2e-demo.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skill",
    "rubric",
    "grading",
    "quality-gate",
    "judge",
    "agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "license": "MIT",
  "author": "hechenhao9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hechenhao9/dsh-judge-loop.git"
  },
  "bugs": {
    "url": "https://github.com/hechenhao9/dsh-judge-loop/issues"
  },
  "homepage": "https://github.com/hechenhao9/dsh-judge-loop#readme"
}
